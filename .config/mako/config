background-color=#343F44
text-color=#D3C6AA
border-color=#A7C080
progress-color=over #A7C080

sort=-time
layer=overlay
width=300
height=300
border-size=1
border-radius=0
padding=10
margin=10
outer-margin=20
icons=0
max-icon-size=64
default-timeout=7000
ignore-timeout=1
font=JetBrains Mono Nerd Font Bold 12
on-button-right=dismiss-all

[urgency=low]
border-color=#859289

[urgency=normal]
border-color=#A7C080

[urgency=critical]
border-color=#E67E80
default-timeout=0

[mode=do-not-disturb]
invisible=1

[category=mpd]
default-timeout=2000
group-by=category

[app-name=Volume-App]
layer=overlay
history=0
anchor=top-center
group-by=app-name
format=<b>%s</b>\n%b
[mode=do-not-disturb]
invisible=1

[app-name=Volume-App grouped=false]
# Force initial volume notification to be visible
invisible=0

[app-name=volume group-index=0]
# Only show last notification
invisible=0
