layout {
    gaps 5
    center-focused-column "never"
    default-column-width {
        proportion 0.5;
    }
    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }
    preset-window-heights {
        proportion 0.25
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }
    border {
        off
        width 2
        active-color "#A7C080"
        inactive-color "#859289"
        urgent-color "#E67E80"
    }
    tab-indicator {
        active-color "#A7C080"
        inactive-color "#859289"
        urgent-color "#E67E80"
    }
    insert-hint {
        color "#A7C08080"
    }
    shadow { off; }
    struts { }
    focus-ring {
        width 2
        active-color "#A7C080"
        inactive-color "transparent"
        urgent-color "#E67E80"
    }
}
