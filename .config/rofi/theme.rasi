configuration {
  emoji  { display-name: "󰞅"; }
  dmenu  { display-name: ""; }
  drun   { display-name: ""; }
  run    { display-name: ""; }
  window { display-name: ""; }
}

* {
  /* General */
  background    : #2D353B;
  foreground    : #D3C6AA;

  background-alt: #343F44;

  border        : #859289;
  accent        : #A7C080;

  selected-bg   : #543A48;
  selected-fg   : #D3C6AA;

  urgent        : #E67E80;
  active        : #83C092;

  background-color: @background;
  border-color    : none;
  font            : "JetBrains Mono Nerd Font 12";
  spacing         : 2;
  text-color      : @foreground;
  text-transform  : capitalize;
}

window {
  location        : north west;
  y-offset        : 30px;
  x-offset        : 30px;
  width           : 25%;
  height          : 15%;
  border          : 1px;
  border-color    : @border;
  border-radius   : 0px;
  background-color: @background;
}

mainbox {
  border       : 2px;
  border-color : @border;
  border-radius: 0;
  children     : [inputbar, listview];
}

message {
  padding: 2px;
  margin : 0;
}

textbox {
  text-color      : @foreground;
  padding         : 0 5px;
  margin          : 10px 5px;
  horizontal-align: 0.5;
  vertical-align  : 0.5;
}

inputbar {
  margin          : 0 0 3px 0;
  children        : [prompt, entry];
  background-color: @background-alt;
  text-color      : @foreground;
}

prompt {
  background-color: inherit;
  text-color      : @foreground;
  padding         : 14px;
}

entry {
  text-color      : @foreground;
  placeholder     : " Search";
  margin          : 0 5px;
  padding         : 0 50px 0 0;
  vertical-align  : 0.5;
  horizontal-align: 0.5;
}

listview {
  lines       : 9;
  dynamic     : true;
  fixed-height: false;
  cycle       : false;
  scrollbar   : false;
  margin      : 0 4px 4px 4px; /* Hide the last element border */
}

element {
  cursor          : pointer;
  orientation     : horizontal;
  children        : [element-text];
  padding         : 4px 5px;
  spacing         : 5px;
  background-color: transparent;
  text-color      : @foreground;
}

element-text {
  text-color    : @foreground;
  cursor        : pointer;
  vertical-align: 0.5;
}

element selected {
  border          : 2px;
  border-color    : @accent;
  background-color: @selected-bg;
  text-color      : @selected-fg;
}

element-text selected {
  text-color  : @foreground;
  border-color: transparent;
  border      : 0 10px;
}

element urgent {
  text-color: @urgent;
}

element active {
  text-color: @active;
}
